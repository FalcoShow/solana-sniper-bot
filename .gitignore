###############################################################################
# God-Tier .gitignore (Render + Python + Windows) — NO SECRETS, NO TRASH
# - Safe defaults for a production bot repo
# - Avoids overly-broad globs that would hide real source/config files
# - Keeps lint/config files tracked (ruff/pyproject/etc)
###############################################################################

# -----------------------------------------------------------------------------
# Python bytecode / caches
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class

.pytest_cache/
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/
.cache/
.ipynb_checkpoints/
*.bak
*.old
*.orig

# -----------------------------------------------------------------------------
# Virtual environments / Python tooling
# -----------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
.conda/
.python-version
__pypackages__/
.tox/
.nox/
.hypothesis/

# -----------------------------------------------------------------------------
# Packaging / builds
# -----------------------------------------------------------------------------
build/
dist/
.eggs/
*.egg-info/
pip-wheel-metadata/
wheelhouse/
*.whl
*.spec

# -----------------------------------------------------------------------------
# Test / coverage artifacts
# -----------------------------------------------------------------------------
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml
test-results/
junit*.xml

# -----------------------------------------------------------------------------
# Logs / runtime artifacts
# -----------------------------------------------------------------------------
*.log
logs/
*.pid
*.pid.*
*.out
*.err

# -----------------------------------------------------------------------------
# Secrets / credentials (ABSOLUTE NO COMMIT)
# -----------------------------------------------------------------------------
# Env files
.env
.env.*
.envrc
!.env.example
!.env.sample
!.env.template

# Render / local secret mounts (if accidentally created in-repo)
etc/secrets/
secrets/
.secrets/
.private/
private/
render_secrets/
sniper_secrets/
.render/
opt/render/

# Wallet / key material
id.json
keypair.json
wallet.json
**/id.json
**/keypair.json
**/wallet.json
*.key
*.pem
*.p12
*.pfx
*.keystore
*.seed
*.mnemonic
*.wallet

# Cloud credentials (common)
.aws/
.gcloud/
*service_account*.json
*credentials*.json

# -----------------------------------------------------------------------------
# Local databases / queues / caches (do NOT commit)
# -----------------------------------------------------------------------------
# Legacy sqlite state (never production)
state.sqlite3
state.sqlite3-*
*.sqlite3
*.sqlite
*.db
*.db-journal

# Redis persistence files (if you ever run Redis locally)
dump.rdb
appendonly.aof

# -----------------------------------------------------------------------------
# Local data outputs (keep repo clean; allow .gitkeep placeholders)
# -----------------------------------------------------------------------------
state/
runtime/
run/
tmp/
temp/

data/
datasets/
exports/
backtests/
reports/
artifacts/
snapshots/

# Common large data formats produced by pipelines
*.jsonl
*.parquet
*.feather

# Allow placeholders so empty dirs can exist if you want them
!data/.gitkeep
!state/.gitkeep
!exports/.gitkeep
!backtests/.gitkeep
!reports/.gitkeep

# -----------------------------------------------------------------------------
# Local backups / scratch
# -----------------------------------------------------------------------------
*.BROKEN_COPY
*_BROKEN_COPY
notes.local.*
scratch/
scratchpad/
dev_notes/

# -----------------------------------------------------------------------------
# IDEs / editors
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.iml
*.swp
*.swo
*.swn

# -----------------------------------------------------------------------------
# OS junk (Windows/macOS/Linux)
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
ehthumbs.db

# -----------------------------------------------------------------------------
# Node / frontend (if present)
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/
.next/
out/

###############################################################################
# Intentional choices:
# - We do NOT ignore *.csv globally (you may track config/whales.csv, etc.)
# - We do NOT ignore project wiring/audit docs
###############################################################################

# If you specifically want this directory ignored, keep it here.
.reports/

###############################################################################
# IMPORTANT:
# Do NOT ignore lint/config files. These must remain tracked for CI parity.
# (Intentionally NOT ignoring ruff.toml / .ruff.toml / pyproject.toml)
###############################################################################
