###############################################################################
# God-Tier .gitignore (Render + Python + Windows) — NO SECRETS, NO TRASH
###############################################################################

# -----------------------------------------------------------------------------
# Python bytecode / caches
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.pyre/
.pytype/
.mypy_cache/
.ruff_cache/
.cache/
.ipynb_checkpoints/
.pytest_cache/

# -----------------------------------------------------------------------------
# Virtual environments (common names)
# -----------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
.conda/
conda-env/
venv*/
venv311/
.python-version

# -----------------------------------------------------------------------------
# Build / packaging
# -----------------------------------------------------------------------------
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
wheelhouse/
*.whl

# -----------------------------------------------------------------------------
# Test / coverage
# -----------------------------------------------------------------------------
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml
test-results/
junit*.xml

# -----------------------------------------------------------------------------
# Logs / runtime artifacts
# -----------------------------------------------------------------------------
*.log
logs/
*.pid
*.pid.*
*.out
*.err

# -----------------------------------------------------------------------------
# Secrets / credentials (ABSOLUTE NO COMMIT)
# -----------------------------------------------------------------------------
.env
.env.*
.env.local
.env.*.local
.envrc
!.env.example
!.env.sample
!.env.template

# Render / local secrets directories
etc/secrets/
secrets/
.private/
private/

# Wallet / key material
id.json
keypair.json
*.key
*.pem
*.p12
*.pfx
*.keystore
*.seed
*.mnemonic
*.wallet
*.secret*
*.private*

# API / cloud credentials (common)
*service_account*.json
*credentials*.json
*gcp*.json
aws-credentials*
.aws/
.gcloud/

# Notion / OAuth / tokens
.notional*
notion_token*
*oauth*
*token*
*api_key*
*apikey*
*secret*

# -----------------------------------------------------------------------------
# Local data stores / state (do NOT commit)
# -----------------------------------------------------------------------------
state.sqlite3
*.sqlite
*.sqlite3
*.db
*.rdb
*.aof

# Local bot state / queues / snapshots / dumps
state/
runtime/
run/
tmp/
temp/
data/
datasets/
exports/
backtests/
reports/
artifacts/
snapshots/
*.jsonl
*.parquet
*.feather
*.csv

# Local backups / audits / scratch
*.BROKEN_COPY
*_BROKEN_COPY
MAIN_WIRING_AUDIT.txt
*WIRING_AUDIT*
*LOCAL_NOTES*
notes.local.*
scratch/
scratchpad/
dev_notes/

# -----------------------------------------------------------------------------
# IDEs / editors
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.iml
*.swp
*.swo
*.swn

# -----------------------------------------------------------------------------
# OS junk (Windows/macOS/Linux)
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
ehthumbs.db

# -----------------------------------------------------------------------------
# Node / frontend (if present)
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/
dist/
.next/
out/

# -----------------------------------------------------------------------------
# Tooling / local scripts (optional)
# -----------------------------------------------------------------------------
tools/
