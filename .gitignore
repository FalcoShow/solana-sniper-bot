###############################################################################
# God-Tier .gitignore (Render + Python + Windows) — NO SECRETS, NO TRASH
#
# Goals:
# - Prevent secrets and key material from ever being committed
# - Keep deploy context clean and deterministic (Render matches your repo)
# - Avoid overly-broad globs that hide real source/config files
# - Keep lint/config files tracked (pyproject, ruff, workflows, etc.)
###############################################################################

# -----------------------------------------------------------------------------
# Merge / scratch helpers (explicit)
# -----------------------------------------------------------------------------
_merge/
.wip_local.patch
mypy.out.txt

# -----------------------------------------------------------------------------
# Python bytecode / caches
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class

.pytest_cache/
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/
.cache/
.ipynb_checkpoints/

# Editor / backup crumbs
*.bak
*.old
*.orig
*.tmp
*.temp
*~

# -----------------------------------------------------------------------------
# Virtual environments / Python tooling
# -----------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
.conda/
__pypackages__/
.tox/
.nox/
.hypothesis/

# NOTE:
# We intentionally DO NOT ignore `.python-version` by default.
# If you use it to pin Python for local parity, it should be tracked.
# (If you personally want it ignored, add it here.)
# .python-version

# -----------------------------------------------------------------------------
# Packaging / builds
# -----------------------------------------------------------------------------
build/
dist/
.eggs/
*.egg-info/
pip-wheel-metadata/
wheelhouse/
*.whl
*.spec

# -----------------------------------------------------------------------------
# Test / coverage artifacts
# -----------------------------------------------------------------------------
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml
test-results/
junit*.xml

# -----------------------------------------------------------------------------
# Logs / runtime artifacts (local only)
# -----------------------------------------------------------------------------
*.log
logs/
*.pid
*.pid.*
*.out
*.err

# -----------------------------------------------------------------------------
# Secrets / credentials (ABSOLUTE NO COMMIT)
# -----------------------------------------------------------------------------
# Env files
.env
.env.*
.envrc
!.env.example
!.env.sample
!.env.template

# Render / local secret mounts (if accidentally created in-repo)
etc/secrets/
secrets/
.secrets/
.private/
private/
render_secrets/
sniper_secrets/
.render/
opt/render/

# Wallet / key material
id.json
keypair.json
wallet.json
**/id.json
**/keypair.json
**/wallet.json
*.key
*.pem
*.p12
*.pfx
*.keystore
*.seed
*.mnemonic
*.wallet

# Cloud credentials (common)
.aws/
.gcloud/
*service_account*.json
*credentials*.json

# -----------------------------------------------------------------------------
# Local databases / queues / caches (do NOT commit)
# -----------------------------------------------------------------------------
# Legacy sqlite state (never production)
state.sqlite3
state.sqlite3-*
*.sqlite3
*.sqlite
*.db
*.db-journal
*.db-wal
*.db-shm

# Redis persistence files (if you ever run Redis locally)
dump.rdb
appendonly.aof

# -----------------------------------------------------------------------------
# Local data outputs (keep repo clean; allow .gitkeep placeholders)
# -----------------------------------------------------------------------------
.state/
state/
runtime/
run/
tmp/
temp/

data/
datasets/
exports/
backtests/
reports/
artifacts/
snapshots/

# Common large data formats produced by pipelines
*.jsonl
*.parquet
*.feather

# Allow placeholders so empty dirs can exist if you want them
!data/.gitkeep
!state/.gitkeep
!exports/.gitkeep
!backtests/.gitkeep
!reports/.gitkeep

# -----------------------------------------------------------------------------
# Local backups / scratch
# -----------------------------------------------------------------------------
*.BROKEN_COPY
*_BROKEN_COPY
notes.local.*
scratch/
scratchpad/
dev_notes/

# -----------------------------------------------------------------------------
# IDEs / editors
# -----------------------------------------------------------------------------
.idea/
*.iml
*.swp
*.swo
*.swn

# VS Code:
# Ignore full workspace, but allow sharing recommended settings if you want.
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# -----------------------------------------------------------------------------
# OS junk (Windows/macOS/Linux)
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
ehthumbs.db
*.stackdump

# -----------------------------------------------------------------------------
# Node / frontend (if present)
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/
.next/
out/

###############################################################################
# Intentional choices:
# - We do NOT ignore *.csv globally (you may track config/whales.csv, etc.)
# - We do NOT ignore project wiring/audit docs
###############################################################################

# If you specifically want this directory ignored, keep it here:
.reports/

# Local Render export (never commit)
render.env

###############################################################################
# IMPORTANT:
# Do NOT ignore lint/config files. These must remain tracked for CI parity.
# (Intentionally NOT ignoring ruff.toml / .ruff.toml / pyproject.toml / workflows)
###############################################################################
