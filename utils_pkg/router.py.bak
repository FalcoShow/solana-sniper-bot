# -------------------------------------------------------------------------
# Logging (shim-safe)
# -------------------------------------------------------------------------
try:
    from logging_setup import get_logger  # type: ignore

    log = get_logger(__name__)  # type: ignore
except Exception:  # pragma: no cover
    import logging

    log = logging.getLogger(__name__)  # type: ignore[assignment]


def _install_log_shims() -> None:
    if not hasattr(log, "event"):

        def _event(name: str, **kw: Any) -> None:  # pragma: no cover
            with contextlib.suppress(Exception):
                log.info("%s %s", name, kw)

        log.event = _event  # type: ignore[attr-defined]

    if not hasattr(log, "every"):

        def _every(key: str, n: int = 10, msg: str | None = None, **kw: Any) -> None:  # pragma: no cover
            try:
                now = time.monotonic()
                store = getattr(_every, "_store", {})  # type: ignore[attr-defined]
                last = float(store.get(key, 0.0))
                if (now - last) >= float(max(1, int(n))):
                    store[key] = now
                    _every._store = store  # type: ignore[attr-defined]
                    ev = getattr(log, "event", None)
                    if callable(ev):
                        ev(msg or key, **kw)
                    else:
                        log.info("%s %s", msg or key, kw)
            except Exception:
                return None

        log.every = _every  # type: ignore[attr-defined]


_install_log_shims()

_TRUE = {"1", "true", "yes", "y", "on", "t"}
_FALSE = {"0", "false", "no", "n", "off", "f"}


def _mono() -> float:
    return time.monotonic()


def _short(x: Any, n: int = 240) -> str:
    try:
        s = str(x)
        return s if len(s) <= n else (s[:n] + "…")
    except Exception:
        return "<?>"


def _envs(k: str, d: str = "") -> str:
    v = os.getenv(k)
    return (v if v is not None else d).strip()


def _env(k: str, d: str = "") -> str:
    """
    Alias used by older/internal router helpers.
    Keep behavior identical to _envs().
    """
    return _envs(k, d)


def _envb(k: str, d: bool = False) -> bool:
    raw = _envs(k, "")
    if raw == "":
        return bool(d)
    s = raw.lower()
    if s in _TRUE:
        return True
    if s in _FALSE:
        return False
    return bool(d)


def _envi(k: str, d: int) -> int:
    try:
        return int(float(_envs(k, str(d))))
    except Exception:
        return int(d)


def _envf(k: str, d: float) -> float:
    try:
        return float(_envs(k, str(d)))
    except Exception:
        return float(d)


def _clamp_i(x: int, lo: int, hi: int) -> int:
    return lo if x < lo else hi if x > hi else x


def _clamp_f(x: float, lo: float, hi: float) -> float:
    return lo if x < lo else hi if x > hi else x


def _to_int(v: Any, default: int | None = None) -> int | None:
    if v is None:
        return default
    if isinstance(v, bool):
        return int(v)
    if isinstance(v, int):
        return int(v)
    if isinstance(v, float):
        return int(v)
    s = str(v).strip()
    if not s:
        return default
    try:
        return int(s)
    except Exception:
        try:
            return int(float(s))
        except Exception:
            return default


def _to_bool(v: Any) -> bool | None:
    if v is None:
        return None
    if isinstance(v, bool):
        return v
    if isinstance(v, (int, float)):
        return bool(int(v))
    s = str(v).strip().lower()
    if not s:
        return None
    if s in _TRUE:
        return True
    if s in _FALSE:
        return False
    return None


async def _maybe_await(x: Any) -> Any:
    if asyncio.iscoroutine(x) or isinstance(x, asyncio.Future):
        return await x
    return x


# -------------------------------------------------------------------------
# Runtime modes
# -------------------------------------------------------------------------
def _is_pytest_runtime() -> bool:
    if os.getenv("PYTEST_CURRENT_TEST"):
        return True
    if _envb("PYTEST_MODE", False):
        return True
    return ("pytest" in sys.modules) or ("_pytest" in sys.modules)


def _hermetic_mode() -> bool:
    return (
        _envb("DRYRUN", False)
        or _envb("DRY_RUN", False)
        or _envb("SAFE_MODE", False)
        or _envb("NO_NETWORK", False)
        or _envb("DISABLE_NETWORK", False)
        or _envb("NETWORK_OFF", False)
    )


def _net_allowed() -> bool:
    return not _hermetic_mode()


def _safe_mode_env() -> bool:
    return _hermetic_mode()


def _is_probe_mode() -> bool:
    # critical: check_router/preflight must not inherit proxies accidentally
    return (_envb("PREFLIGHT", False) or _envb("CHECK_ROUTER", False))


# --- Offline test plumbing: pin the session used by /quote so /swap reuses it ---
_LAST_HTTP_SESSION = None

def _is_capturing_like(o) -> bool:
    try:
        return bool(
            o is not None
            and hasattr(o, "get_calls")
            and hasattr(o, "post_calls")
            and callable(getattr(o, "get", None))
            and callable(getattr(o, "post", None))
        )
    except Exception:
        return False

def _set_last_http_session(s) -> None:
    global _LAST_HTTP_SESSION
    if s is None:
        return
    # Don't overwrite a capturing session with a non-capturing one
    if _is_capturing_like(_LAST_HTTP_SESSION) and (not _is_capturing_like(s)):
        return
    _LAST_HTTP_SESSION = s

def _get_last_http_session():
    return _LAST_HTTP_SESSION

