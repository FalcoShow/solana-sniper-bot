# ==============================================================================
# .renderignore — minimize upload context to Render (fast, deterministic builds)
# ==============================================================================
# Render uploads your repo to build/run. Anything excluded here:
#   - is NOT sent to Render
#   - cannot be referenced during build/runtime
#
# Goals:
#   1) Keep deploys fast (exclude big local junk)
#   2) Avoid leaking secrets (exclude .env, key material)
#   3) Keep build deterministic (exclude local caches/artifacts)
#
# IMPORTANT:
# - Do NOT exclude source code needed at runtime.
# - Do NOT exclude requirements / pyproject / start scripts / render.yaml / Procfile.
# ==============================================================================

# ------------------------------------------------------------------------------
# VCS + repo tooling noise
# ------------------------------------------------------------------------------
.git/
.gitignore
.gitattributes

# ------------------------------------------------------------------------------
# Python: virtualenvs + caches
# ------------------------------------------------------------------------------
.venv/
venv/
venv*/
__pycache__/
**/__pycache__/
*.py[cod]
*.pyd
*.pyo
*.so
*.dll

.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.pyre/
.pyright/
.ipynb_checkpoints/

# Coverage / test artifacts (safe to exclude from deploy context)
.coverage
.coverage.*
htmlcov/
coverage.xml
test-results/
junit*.xml

# ------------------------------------------------------------------------------
# Local env / secrets (NEVER upload)
# ------------------------------------------------------------------------------
.env
.env.*
.envrc
*.local

# Common secret folders
secrets/
etc/secrets/
.private/
private/
credentials/
creds/
keys/

# Key material / wallets / certs
id.json
keypair.json
*.pem
*.p12
*.pfx
*.key
*.keystore
*.jks
*.seed
*.mnemonic
*.wallet
*.crt
*.cer

# ------------------------------------------------------------------------------
# Logs + temp outputs (your recent run artifacts included)
# ------------------------------------------------------------------------------
*.log
logs/
err.log
out.json

# Common temp / scratch
tmp/
temp/
*.tmp
*.swp
*.swo

# ------------------------------------------------------------------------------
# Local data / large artifacts (keep deploy lean)
# ------------------------------------------------------------------------------
artifacts/
exports/
snapshots/
reports/
backtests/
datasets/
data/
downloads/
uploads/

# Database / state files (should NOT be shipped)
state.sqlite3
database.sqlite
*.sqlite
*.sqlite3
*.db
*.duckdb

# ------------------------------------------------------------------------------
# OS / editor junk
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.code-workspace

# ------------------------------------------------------------------------------
# Node / frontend junk (if present)
# ------------------------------------------------------------------------------
node_modules/
.pnpm-store/
.yarn/
.next/
out/
dist/
build/
.cache/

# ------------------------------------------------------------------------------
# Keep (explicit allowlist — prevents accidental exclusions)
# ------------------------------------------------------------------------------
!requirements.txt
!pyproject.toml
!poetry.lock
!uv.lock
!Pipfile
!Pipfile.lock
!runtime.txt
!.python-version

!render.yaml
!Procfile
!start.sh
!scripts/**
!utils_pkg/**
!daytrader/**
!sniper/**
!tests/**
