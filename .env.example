# ==============================================================================
# .env.example — God-Tier Overhaul Env Contract (Render + Local identical)
# ==============================================================================
# ✅ RULES / GUARANTEES
# - Copy this to ".env" for local dev (NEVER commit .env)
# - On Render: set these as Environment Variables (Secrets). NEVER commit secrets.
# - SAFE DEFAULTS: no trades by default (SAFE_MODE=1, DRYRUN=1, TRADING_ENABLED=0).
# - Canonical + legacy aliases included to avoid drift across modules.
# - Each KEY appears ONCE as an assignment in this file.
#
# ✅ GO-LIVE MINIMUM (baseline infra)
#   SOL_RPC_URL=https://<your-rpc-host>/
#   REDIS_URL=rediss://<user>:<pass>@<host>:<port>/<db>
#   DATABASE_URL=postgresql://<user>:<pass>@<host>/<db>?sslmode=require
#   KEYPAIR_PATH=/etc/secrets/wallet.json   (or WALLET_JSON_B64=... or WALLET_JSON=...)
#
# ✅ GO-LIVE SWITCHES (explicit)
#   TRADING_ENABLED=1
#   SAFE_MODE=0
#   DRYRUN=0
#   DISABLE_BUYS=0
#   DISABLE_SELLS=0
#   DISABLE_SCANNERS=0
#   DISABLE_NETWORK=0
#
# ✅ CONTRACT NOTE
# - utils_pkg/contracts.py is the canonical ENV key contract.
# - start.sh enforces boot gates + DSN normalization + env-load order.
# ==============================================================================


# ==============================================================================
# [A] APP IDENTITY / MODE
# ==============================================================================
APP_NAME=pnlsniper
APP_ENV=development              # development|staging|production
ENV=development                  # legacy alias
TZ=UTC

# Platform metadata (optional; CI/Render may populate)
RUN_ID=
INSTANCE_ID=local
GIT_COMMIT=
GIT_SHA=
VERSION=
SERVICE=sniper
LOG_ENV=
LOG_SERVICE=sniper
LOG_VERSION=v1

RENDER=0
RENDER_SERVICE_ID=
RENDER_INSTANCE_ID=
RENDER_EXTERNAL_URL=

HOSTNAME=
REPO_ROOT=


# ==============================================================================
# [B] BOOTSTRAP SPINE (start.sh contract)
# ==============================================================================
# NOTE (Windows): start.sh runs on Render (Linux). Locally validate with:
#   py -m scripts.preflight --json-only
#   py -m pytest -q

# Entrypoint selection
RUN_MODE=bot                     # bot|main|backtest|daytrader|paper_label
RUN_MODULE_OVERRIDE=             # optional: force python module
RUN_ARGS=                        # optional: shlex-split string of args
RUN_ARGS_FILE=                   # optional: one arg per line
RUN_ARGS_JSON=                   # optional: JSON array of args: ["--x","1"]

# Gate behavior
START_STRICT=                    # blank = inferred (Render=>1, local=>0)
START_PRECHECKS=1
START_RUN_CHECK_ENV=1
START_RUN_CI_SMOKE=0

# Dotenv loading behavior
CORE_LOAD_DOTENV=1               # legacy contract key some modules reference
START_NO_DOTENV=0
START_ENV_FILES=                 # comma/semicolon list; blank = default scan paths
START_ENV_OVERRIDE=0             # 1 = env file overrides already-set env vars
START_ALLOW_SOURCE_ENV=0         # 1 = unsafe "source" mode (off by default)

# Wallet materialization options
START_SKIP_WALLET=0
START_WALLET_OVERWRITE=0

# Redis synthesis overrides
START_REDIS_OVERRIDE=0
REDIS_DB=0
REDIS_TLS=0

# DSN normalization/export
START_NORMALIZE_DSN=1
START_ADD_SSLMODE=               # blank = inferred (Render=>1)
SKIP_DSN_REQUIRED=               # blank = inferred (Render=>0, local=>1)

# Supervisor policy (restart spine)
MAIN_RESTART_ON_CRASH=1
MAIN_MAX_RESTARTS=0              # 0=infinite
MAIN_RESTART_BACKOFF_S=3
MAIN_RESTART_MAX_BACKOFF_S=30
MAIN_RESTART_JITTER_S=2
MAIN_NO_RESTART_EXIT_CODES=130,143
MAIN_USE_SETSID=1

# Optional runtime hints
START_ULIMIT_NOFILE=0            # 0=no change; else try to set ulimit -n


# ==============================================================================
# [C] ENV VALIDATION / FAIL-FAST
# ==============================================================================
STRICT_ENV=0                     # 0=warn, 1=hard fail on missing required vars
ENV_STRICT=0                     # legacy alias
MAIN_FAST_FAIL=0                 # 1=crash early on misconfig
MAIN_FAST_FAIL_EARLY=0           # extra guard

RUNTIME_PROFILE=safe             # safe|paper|live
PYTEST_MODE=0
PYTEST_RUNNING=0
PYTEST_CURRENT_TEST=
PYTEST_SEED=
PYTEST_SAMPLE_TS=

SNIPER_DISABLE_PYTEST_PLUGIN_AUTOLOAD=0
PYTEST_DISABLE_PLUGIN_AUTOLOAD=0

MAIN_DISABLE_RANDOM_JITTER=1
DRIFT_ENV=
DRIFT_RPC_URL=

SANDBOX_MODE=
SHADOW_MODE_GLOBAL=
MAIN_PASSTHROUGH_ARGS=

ENTRYPOINT_MODULE=
APP_ENTRYPOINT_MODULE=

# Smoke / diagnostics harness toggles
SMOKE=0
SMOKE_CORE=0
SMOKE_INIT=0
SMOKE_LIGHTNING=0

# Backtest harness toggles
BACKTEST_MODE=0
BT_NO_SIDE_EFFECTS=1

# Policy / global phases (if used by code)
MASTER_PHASE=7
STRATEGY_PHASE=7


# ==============================================================================
# [D] GLOBAL SAFETY SWITCHES (SAFE DEFAULTS)
# ==============================================================================
# Master gates
TRADING_ENABLED=0                # must be 1 to trade
PAUSE_TRADING=0
PANIC_STOP=0
KILL_SWITCH=0

SAFE_MODE=1
DRYRUN=1
DRY_RUN=1                        # legacy alias
IS_DRYRUN=
BUY_DRYRUN=
PF_DRYRUN=

# Fine-grained permissions
DISABLE_BUYS=1
DISABLE_SELLS=1
DISABLE_SCANNERS=1

# Optional legacy “allow” gates (kept for compatibility)
ALLOW_BUYS=0
ALLOW_SELLS=0
LIVE_TRADING=0
DISABLE_LIVE_TRADING=1

# Network global gates
NO_NETWORK=0
DISABLE_NETWORK=0
DISABLE_HTTP=
DISABLE_RPC=

# Workers (default OFF)
AUTO_EXIT_WORKER_ENABLED=0
EXIT_ENGINE_WORKER_ENABLED=0
REINVESTOR_ENABLED=0
SMART_WALLETS_ENABLED=0

# Budget guard
BUDGET_DISABLE=0


# ==============================================================================
# [E] PREFLIGHT / BOOT (scripts/preflight.py + scripts/check_env.py)
# ==============================================================================
PREFLIGHT_PROFILE=deploy         # fast|deploy|full
PREFLIGHT_STEP_TIMEOUT_S=90
PREFLIGHT_TOTAL_TIMEOUT_S=0
PREFLIGHT_JSON=1
PREFLIGHT_JSON_ONLY=0
PREFLIGHT_VERBOSE=0
PREFLIGHT_FAIL_ON_OPTIONAL=0

PREFLIGHT_RETRY_MAX=1
PREFLIGHT_RETRY_BASE_S=0.6
PREFLIGHT_RETRY_JITTER_S=0.4
PREFLIGHT_RETRY_STEPS=check_dns,check_rpc,check_router,smoke_lightning,healthcheck

# Skip knobs
SKIP_PREFLIGHT_DNS=0
SKIP_SMOKE_LIGHTNING=0
SKIP_PREFLIGHT_HEALTHCHECK=0
SKIP_HEALTHCHECK=0
ALLOW_SCHEMA_CREATE=0

PREFLIGHT_MAX_BYTES=196608
PREFLIGHT_MAX_OUTPUT=3500

# Router check behavior
CHECK_ROUTER_LOAD_DOTENV=1

# check_env runner knobs
CHECK_ENV_ENV_FILE=
CHECK_ENV_VALIDATE_ENV=
CHECK_ENV_DNS=
CHECK_ENV_FAILFAST=
CHECK_ENV_STRICT=
CHECK_ENV_JSON=
CHECK_ENV_JSON_ONLY=
CHECK_ENV_SHOW_ENV=


# -----------------------------------------------------------------------------
# Smoke init gate (scripts/smoke_init.py)
# -----------------------------------------------------------------------------
# Emit JSON summary to STDOUT (in addition to human stderr logs)
SMOKE_INIT_JSON=0

# Only emit JSON (no human logs)
SMOKE_INIT_JSON_ONLY=0

# Enable optional non-destructive probes (redis ping / pg SELECT 1) when available
SMOKE_INIT_PROBES=0

# Force skip probes
SMOKE_INIT_SKIP_PROBES=0

# Timeout for init+probes (seconds)
SMOKE_INIT_TIMEOUT_S=60

# Debug: do not call close_resources() (not recommended)
SMOKE_INIT_NO_CLOSE=0

# Do not attempt to load .env via python-dotenv
SMOKE_INIT_NO_DOTENV=0

# scripts/check_env internal toggles (CI/test harness)
CHECK_ENV_SKIP_CONFIG=0
CHECK_ENV_REQUIRE_CONFIG=0

# Preflight DNS policy:
# - auto  : strict on Render, soft locally
# - strict: require all/most hostnames to resolve
# - soft  : allow partial DNS failures (local dev)
# - off   : skip DNS step entirely
PREFLIGHT_DNS_MODE=auto
PREFLIGHT_DNS_MIN_OK=1
PREFLIGHT_DNS_ATTEMPTS=3
PREFLIGHT_DNS_SKIP_INTERNAL=1
PREFLIGHT_DNS_HOSTS=api.jup.ag,public.jupiterapi.com
PREFLIGHT_DNS_OFF=0
PREFLIGHT_DNS_STRICT=0

# ==============================================================================
# [F] PYTHON RUNTIME HINTS
# ==============================================================================
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
PYTHONHASHSEED=
TOKENIZERS_PARALLELISM=false


# ==============================================================================
# [G] LOGGING
# ==============================================================================
LOG_LEVEL=INFO                   # DEBUG|INFO|WARNING|ERROR
LOG_JSON=1
LOG_TIME_UTC=1
LOG_INCLUDE_SRC=0

LOG_INCLUDE_PROCESS=1
LOG_INCLUDE_HOST=1
LOG_SAMPLING=0
