# ===================================================================
# .env.example — Canonical Env Contract (Generated from contracts.py)
# ===================================================================
#
# Rules:
# - Do NOT store real secrets here.
# - Keep this file aligned with CANONICAL_ENV_VARS in utils_pkg/contracts.py
# - Tests may enforce exact alignment to prevent drift.

# App name
APP_NAME=pnlsniper

# development|staging|production
APP_ENV=development

# Legacy alias for APP_ENV
ENV=development

# Timezone label
TZ=UTC

# Run identifier (CI/Render optional)
RUN_ID=

# Instance identifier
INSTANCE_ID=local

# Git commit (optional)
GIT_COMMIT=

# Git SHA (optional)
GIT_SHA=

# App version (optional)
VERSION=

# Service name (optional)
SERVICE=sniper

# Logging env override (optional)
LOG_ENV=

# Logging service name (optional)
LOG_SERVICE=sniper

# Logging version (optional)
LOG_VERSION=v1

# Render detected flag (optional)
RENDER=0

# Render service id (optional)
RENDER_SERVICE_ID=

# Render instance id (optional)
RENDER_INSTANCE_ID=

# Render external URL (optional)
RENDER_EXTERNAL_URL=

# Hostname (optional)
HOSTNAME=

STRICT_ENV=0  # required; 0=warn, 1=hard fail on missing required vars

# Legacy alias for STRICT_ENV
ENV_STRICT=0

# 1=crash early on misconfig
MAIN_FAST_FAIL_EARLY=0

# safe|paper|live
RUNTIME_PROFILE=safe

# Override main HTTP port (optional; scripts/main.py)
MAIN_HTTP_PORT=

# Override HTTP port (optional; scripts/main.py)
HTTP_PORT=

# Optional proxy bypass list (comma-separated hosts/domains/IPs). Supports upper/lowercase forms.
NO_PROXY=

# Optional override for repo root discovery
REPO_ROOT=

# Safe imports (tests/CI default)
SAFE_MODE=1

# Pytest safety toggle (set by CI)
PYTEST_MODE=0

# pytest guard
PYTEST_RUNNING=0

# Backtest harness mode
BACKTEST_MODE=0

# Backtest: disable side effects
BT_NO_SIDE_EFFECTS=1

# No live trading
DRYRUN=1

# No live trading
DRY_RUN=1

# Disable outbound network (hard safety)
NO_NETWORK=0

# Disable outbound network (hard safety)
DISABLE_NETWORK=0

# Master live toggle
LIVE_TRADING=0

# Force live off
DISABLE_LIVE_TRADING=1

# Disable budget circuit breaker (dev/testing only)
BUDGET_DISABLE=0

# Deterministic behavior in tests/CI
MAIN_DISABLE_RANDOM_JITTER=0

# Allow dotenv side effects (set 0 in tests)
CORE_LOAD_DOTENV=1

# Network label: mainnet/devnet/local
NETWORK=mainnet

# Solana RPC URL
RPC_URL=

# RPC timeout seconds
RPC_TIMEOUT_S=8

# RPC commitment
RPC_COMMITMENT=confirmed

# Wallet keypair file path
KEYPAIR_PATH=

# Wallet private key
WALLET_PRIVATE_KEY=

# Optional wallet pubkey (non-secret)
WALLET_PUBLIC_KEY=

# Enable Redis
REDIS_ENABLED=1

# Disable Redis quickly
DISABLE_REDIS=0

# Redis URL
REDIS_URL=

# Key prefix namespace
REDIS_NAMESPACE=sniper

# Redis connect timeout seconds
REDIS_CONNECT_TIMEOUT_S=5

# Redis op timeout seconds
REDIS_OP_TIMEOUT_S=3

# Set key of active tick keys
TICK_ACTIVE_KEYS=tick:active:keys

# Set key of active mints
TICK_ACTIVE_MINTS_KEY=tick:active:mints

# Set key of active positions
TICK_ACTIVE_POSITIONS_KEY=tick:active:positions

# Redis stream key for ticks
TICK_STREAM_REDIS_STREAM_KEY=tick:stream

# Hotlist worker: Redis lock TTL seconds (hotlist_worker.py fallback=120)
HOTLIST_LOCK_TTL_SEC=120

# Postgres DSN
POSTGRES_DSN=

# Compat: DATABASE_URL (if used)
DATABASE_URL=

# asyncpg pool min size
PG_POOL_MIN=0

# asyncpg pool max size
PG_POOL_MAX=5

# Postgres connect timeout seconds
PG_CONN_TIMEOUT_S=8

# Allow Jupiter usage (default off in CI)
JUPITER_ENABLED=0

# Jupiter API base URL
JUPITER_BASE_URL=https://quote-api.jup.ag

# Max slippage bps
JUPITER_MAX_SLIPPAGE_BPS=200

# HTTP timeout seconds
JUPITER_TIMEOUT_S=8

# Optional Jupiter API key
JUPITER_API_KEY=

# Allow swaps in harness (default off)
SWAPS_ENABLED=0

# Master scanner enable
SCANNER_ENABLED=1

# Opt-in gate for live scanner tests
SCANNER_LIVE_TESTS=0

# Scanner poll interval seconds
SCANNER_INTERVAL_S=2

# Enable Raydium scanner
SCAN_RAYDIUM=1

# Enable Pump.fun scanner
SCAN_PUMPFUN=1

# Enable Dexscreener scanner
SCAN_DEXSCREENER=1

# Enable Axiom scanner
SCAN_AXIOM=0

# Warn on raydium shim use
RAYDIUM_SHIM_WARN=0

# Pumpfun impl module
PUMPFUN_IMPL_MODULE=scanner.pumpfun_scanner

# Import throttle
PUMPFUN_IMPL_IMPORT_ERR_COOLDOWN_S=15

# Warn on axiom shim use
AXIOM_SHIM_WARN=0

# Axiom impl module
AXIOM_IMPL_MODULE=scanner.axiom_scanner

# Default risk profile
RISK_PROFILE_DEFAULT=balanced

# Max concurrent positions
MAX_CONCURRENCY=1

# Max inflight orders
MAX_INFLIGHT_ORDERS=1

# Default buy size in SOL
TICKET_SOL=0.01

# Pump.fun ticket size USD fallback (velocity_worker.py fallback=20)
PF_TICKET_USD=20

# Stop loss percent
STOP_LOSS_PCT=25

# Take profit percent
TAKE_PROFIT_PCT=60

# Trailing arm percent
TRAILING_ARM_PCT=35

# Trailing percent
TRAILING_PCT=18

# Log level
LOG_LEVEL=INFO

# Enable JSON logs
LOG_JSON=1

# Logging: force UTC timestamps
LOG_TIME_UTC=1

# Logging: include source fields
LOG_INCLUDE_SRC=0

# Task spawn: capture origin frames for debugging (0/1)
TASK_SPAWN_CAPTURE_ORIGIN=0

# Task spawn: number of origin frames to record (1..10 recommended)
TASK_SPAWN_ORIGIN_FRAMES=2

# Enable Telegram alerts
TELEGRAM_ENABLED=0

# Telegram bot token
TELEGRAM_BOT_TOKEN=

# Telegram chat id
TELEGRAM_CHAT_ID=

# Enable Discord alerts
DISCORD_ENABLED=0

# Discord webhook URL
DISCORD_WEBHOOK_URL=

# Enable Notion logging
NOTION_ENABLED=0

# Notion token
NOTION_TOKEN=

# Notion DB
NOTION_DATABASE_ID=

# Enable playbook Notion logging
PLAYBOOK_NOTION_ENABLED=0

# Notion timeout seconds
PLAYBOOK_NOTION_TIMEOUT_SEC=8

# Status key prefix
PLAYBOOK_STATUS_PREFIX=pb:status:

# Status TTL seconds
PLAYBOOK_STATUS_TTL_SEC=900

# Playbook stream key
PLAYBOOK_STREAM_KEY=pb:stream

# Stream maxlen
PLAYBOOK_STREAM_MAXLEN=2000

# Heartbeat period seconds
PLAYBOOK_HEARTBEAT_SEC=15

# Max field string length
PLAYBOOK_MAX_FIELD_STR=400

# Max message string length
PLAYBOOK_MAX_MSG_STR=1200

# Notion dedupe TTL seconds
PLAYBOOK_NOTION_DEDUPE_TTL_SEC=600

# Diagnostics default timeout seconds
DIAG_TIMEOUT_S=20

# Risk diagnostics timeout seconds
RISK_DIAG_TIMEOUT_S=20

# Test stack timeout seconds
TEST_STACK_TIMEOUT=30

# Allow scripts that do dry-run probes
ALLOW_DRY_RUN_SCRIPT=1

# Allow quote probe in tests
ALLOW_TEST_QUOTE_SCRIPT=1

# Quote size for tests (SOL)
TEST_QUOTE_SOL=0.001

# Quote size for dryrun scripts (SOL)
DRYRUN_QUOTE_SOL=0.001

# Dryrun timeout seconds
DRYRUN_TIMEOUT_S=12

# Project-level switch for pytest plugin autoload handling
SNIPER_DISABLE_PYTEST_PLUGIN_AUTOLOAD=0

# (internal) If set, scripts/check_env skips importing config.py checks.
CHECK_ENV_SKIP_CONFIG=0

# (internal) If set, scripts/check_env requires config.py import to succeed (strict).
CHECK_ENV_REQUIRE_CONFIG=0

# pytest native knob
PYTEST_DISABLE_PLUGIN_AUTOLOAD=0

# Emit JSON summary to STDOUT (in addition to human stderr logs)
SMOKE_INIT_JSON=0

# Only emit JSON (no human logs)
SMOKE_INIT_JSON_ONLY=0

# Enable optional non-destructive probes (redis ping / pg SELECT 1) when available
SMOKE_INIT_PROBES=0

# Force skip probes (overrides SMOKE_INIT_PROBES)
SMOKE_INIT_SKIP_PROBES=0

# Timeout for init+probes (seconds)
SMOKE_INIT_TIMEOUT_S=60

# Debug: do not call close_resources() (not recommended)
SMOKE_INIT_NO_CLOSE=0

# Do not attempt to load .env via python-dotenv
SMOKE_INIT_NO_DOTENV=0

# DNS policy: auto|strict|soft|off (auto=strict on Render, soft locally)
PREFLIGHT_DNS_MODE=auto

# Minimum number of hostnames that must resolve for DNS step to pass
PREFLIGHT_DNS_MIN_OK=1

# DNS resolution attempts per hostname
PREFLIGHT_DNS_ATTEMPTS=3

# Skip internal/localhost-style DNS checks (recommended for local dev)
PREFLIGHT_DNS_SKIP_INTERNAL=1

# Comma-separated hostnames to resolve in DNS step
PREFLIGHT_DNS_HOSTS=api.jup.ag,public.jupiterapi.com

# Hard disable DNS step (overrides mode)
PREFLIGHT_DNS_OFF=0

# Force strict DNS behavior (overrides mode)
PREFLIGHT_DNS_STRICT=0

# Set to 1 when running scripts/check_router
CHECK_ROUTER=0

# Contract test guard
CONTRACT_TEST=0

# Set to 1 when running scripts/preflight
PREFLIGHT=0

# Contract test guard
SNIPER_TEST_CONTRACT=0

# Data directory
DATA_DIR=./data

# State directory
STATE_DIR=./state

# Log directory
LOG_DIR=./logs

# Cache directory
CACHE_DIR=./cache

# Exports directory
EXPORT_DIR=./exports

