# =============================================================================
# .gitattributes — God-Tier repo hygiene (Windows dev + Render/Linux deploy)
#
# Goals:
#   - No CRLF/LF churn in diffs
#   - Render/Linux runtime files are ALWAYS LF
#   - Windows scripts stay CRLF (better local UX)
#   - True binaries never get EOL conversion
# =============================================================================

# Default: normalize text to LF (prevents deploy issues on Linux/Render)
* text=auto eol=lf

# -----------------------------------------------------------------------------
# Source / config files: force LF
# -----------------------------------------------------------------------------
*.py        text eol=lf
*.pyi       text eol=lf
*.pyx       text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.rst       text eol=lf
*.toml      text eol=lf
*.ini       text eol=lf
*.cfg       text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.json      text eol=lf
*.csv       text eol=lf
*.tsv       text eol=lf
*.sql       text eol=lf
*.env       text eol=lf
*.example   text eol=lf
*.lock      text eol=lf
*.xml       text eol=lf
*.graphql   text eol=lf
*.proto     text eol=lf
*.sh        text eol=lf
*.bash      text eol=lf
*.zsh       text eol=lf

# -----------------------------------------------------------------------------
# Windows scripts: keep CRLF
# -----------------------------------------------------------------------------
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf
*.psm1      text eol=crlf

# -----------------------------------------------------------------------------
# CI / deploy / repo meta: LF
# -----------------------------------------------------------------------------
.gitattributes              text eol=lf
.gitignore                  text eol=lf
.renderignore               text eol=lf
Procfile                    text eol=lf
Dockerfile                  text eol=lf
docker-compose.yml          text eol=lf
render.yaml                 text eol=lf
.github/workflows/*.yml     text eol=lf
.github/workflows/*.yaml    text eol=lf

# Jupyter notebooks are JSON; keep LF for stable diffs
*.ipynb     text eol=lf

# -----------------------------------------------------------------------------
# Binaries: never apply EOL conversion
# -----------------------------------------------------------------------------
*.png       -text
*.jpg       -text
*.jpeg      -text
*.gif       -text
*.webp      -text
*.ico       -text
*.pdf       -text

*.zip       -text
*.7z        -text
*.gz        -text
*.tgz       -text
*.bz2       -text

*.whl       -text
*.pyd       -text
*.so        -text
*.dll       -text
*.exe       -text

# Keys/certs: avoid accidental normalization
*.pem       -text
*.crt       -text
*.cer       -text
*.key       -text
