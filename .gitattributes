# =============================================================================
# .gitattributes — God-Tier repo hygiene (Windows dev + Render/Linux deploy)
#
# Goals:
#   - No CRLF/LF churn in diffs
#   - Render/Linux runtime files are ALWAYS LF
#   - Windows scripts stay CRLF (better local UX)
#   - True binaries never get EOL conversion
# =============================================================================

# Default: normalize text to LF (prevents deploy issues on Linux/Render)
* text=auto eol=lf

# -----------------------------------------------------------------------------
# Source / config / docs: force LF
# -----------------------------------------------------------------------------
*.py        text eol=lf
*.pyi       text eol=lf
*.pyx       text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.rst       text eol=lf
*.toml      text eol=lf
*.ini       text eol=lf
*.cfg       text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.json      text eol=lf
*.ndjson    text eol=lf
*.csv       text eol=lf
*.tsv       text eol=lf
*.sql       text eol=lf
*.xml       text eol=lf
*.svg       text eol=lf
*.graphql   text eol=lf
*.proto     text eol=lf
*.lock      text eol=lf
*.env       text eol=lf
*.example   text eol=lf
*.diff      text eol=lf
*.patch     text eol=lf

# Shell scripts MUST be LF (even on Windows) for CI/Render
*.sh        text eol=lf
*.bash      text eol=lf
*.zsh       text eol=lf

# -----------------------------------------------------------------------------
# Windows scripts: keep CRLF
# -----------------------------------------------------------------------------
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf
*.psm1      text eol=crlf

# -----------------------------------------------------------------------------
# CI / deploy / repo meta: LF
# -----------------------------------------------------------------------------
.gitattributes               text eol=lf
.gitignore                   text eol=lf
.renderignore                text eol=lf
Procfile                     text eol=lf
Dockerfile                   text eol=lf
docker-compose.yml           text eol=lf
render.yaml                  text eol=lf
.github/workflows/*.yml      text eol=lf
.github/workflows/*.yaml     text eol=lf

# Jupyter notebooks are JSON; keep LF for stable diffs
*.ipynb      text eol=lf

# -----------------------------------------------------------------------------
# Binaries: never apply EOL conversion (binary = -text -diff)
# -----------------------------------------------------------------------------
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.webp       binary
*.ico        binary
*.pdf        binary

*.zip        binary
*.7z         binary
*.gz         binary
*.tgz        binary
*.bz2        binary

*.whl        binary
*.pyd        binary
*.so         binary
*.dll        binary
*.exe        binary

# Data/binaries that should never be normalized (even if accidentally tracked)
*.sqlite     binary
*.sqlite3    binary
*.db         binary

# Keys/certs: avoid accidental normalization/diffing
*.pem        binary
*.crt        binary
*.cer        binary
*.key        binary
